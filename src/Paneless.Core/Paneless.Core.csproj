<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Paneless.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The on-device helper for app names and icons; built from tools/android-helper (see its build.ps1). -->
    <EmbeddedResource Include="Assets/paneless-helper.jar" LogicalName="Paneless.Core.paneless-helper.jar" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
