<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneless.App.ViewModels"
             xmlns:l="using:Paneless.App.Localization"
             x:Class="Paneless.App.Views.LogsPage"
             x:DataType="vm:LogsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,12">
      <TextBlock Classes="pagetitle" Text="{l:T 'Logs'}" />
      <TextBlock Classes="pagehint" Text="{l:T 'The live log of a device (logcat). Filter it by importance, text or app; app crashes are shown in red.'}" />
    </StackPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,10">
      <ComboBox Width="190" ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}" PlaceholderText="{l:T 'Device'}" />
      <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" MinWidth="80" Content="{Binding StartLabel}" Command="{Binding ToggleCommand}" />
      <ComboBox Grid.Column="2" Width="180" Margin="8,0,0,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" />
      <Grid Grid.Column="3" ColumnDefinitions="*,8,*" Margin="8,0,0,0">
        <TextBox Text="{Binding Filter}" PlaceholderText="{l:T 'Filter text'}" />
        <TextBox Grid.Column="2" Text="{Binding App}" PlaceholderText="{l:T 'Only this app, e.g. com.example.app'}" />
      </Grid>
      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
        <Button Classes="flat" Content="{l:T 'Clear'}" Command="{Binding ClearCommand}" />
        <Button Classes="flat" Content="{l:T 'Save…'}" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,*" Margin="0,8,0,0">
      <CheckBox Content="{l:T 'Crashes only'}" IsChecked="{Binding CrashesOnly}" />
      <CheckBox Grid.Column="1" Content="{l:T 'Follow the newest lines'}" IsChecked="{Binding FollowNewest}" Margin="16,0,0,0" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <TextBlock Classes="small" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"
                   Text="{Binding Crashes, StringFormat='{}{0} ⚠'}" IsVisible="{Binding HasCrashes}" ToolTip.Tip="{l:T 'App crashes in this log'}" />
        <TextBlock Classes="small" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <Border Classes="card" ClipToBounds="True">
      <Panel>
        <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogItem">
              <Grid ColumnDefinitions="92,18,150,*" TextElement.FontFamily="Cascadia Mono, Consolas, Menlo, monospace">
                <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{StaticResource DimBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Level}" FontSize="12" Foreground="{Binding Brush}" />
                <TextBlock Grid.Column="2" Text="{Binding Tag}" FontSize="12" Foreground="{StaticResource DimBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" Foreground="{Binding Brush}" FontWeight="{Binding Weight}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="dim" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                   Text="{l:T 'Choose a device and click Start.'}" />
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
