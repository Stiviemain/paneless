<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.UnlockWindow"
        x:DataType="vm:UnlockViewModel"
        Title="{l:T 'Auto-unlock'}" Icon="/Assets/Paneless.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <StackPanel Margin="24,20" Spacing="12">
    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Classes="dim" TextWrapping="Wrap" Text="{Binding Intro}" />

    <StackPanel Spacing="6">
      <TextBlock Classes="dim" FontSize="12" Text="{l:T 'PIN or password'}" />
      <TextBox x:Name="CodeBox" Text="{Binding Code}" PasswordChar="•" />
      <TextBlock Classes="dim" FontSize="12" Text="{l:T 'Type it again'}" Margin="0,6,0,0" />
      <TextBox Text="{Binding Confirm}" PasswordChar="•" />
    </StackPanel>

    <TextBlock Foreground="{DynamicResource AmberBrush}" FontSize="12" TextWrapping="Wrap" Text="{Binding Warning}" />
    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" MinHeight="20" />

    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Classes="danger" Content="{l:T 'Remove code'}" Command="{Binding RemoveCommand}" IsVisible="{Binding HasCode}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
        <Button Classes="accent" Content="{l:T 'Save'}" MinWidth="90" Command="{Binding SaveCommand}" IsDefault="True" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
