<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.ScriptsWindow"
        x:DataType="vm:ScriptsViewModel"
        Title="Paneless scripts" Icon="/Assets/Paneless.ico"
        Width="1220" Height="740" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ListBox#ScriptList ListBoxItem">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox#ScriptList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SelBrush}" />
    </Style>
    <Style Selector="Path.chevron">
      <Setter Property="Stroke" Value="{StaticResource DimBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="ToggleButton.chev">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.chev:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="290,20,*,20,270" Margin="20,18">

    <!-- library -->
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,8,Auto" Margin="0,0,0,10">
        <TextBox Text="{Binding Search}" PlaceholderText="Search scripts" />
        <Button Grid.Column="2" Content="+ New" Command="{Binding NewScriptCommand}" />
      </Grid>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <ListBox x:Name="ScriptList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedEntry}" Background="Transparent">
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:CategoryHeader">
              <TextBlock Text="{Binding Title}" Foreground="{StaticResource DimBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
            </DataTemplate>
            <DataTemplate DataType="vm:ListHint">
              <TextBlock Text="{Binding Text}" Foreground="{StaticResource DimBrush}" FontSize="12" FontStyle="Italic"
                         TextWrapping="Wrap" Margin="8,0,0,0" />
            </DataTemplate>
            <DataTemplate DataType="vm:ScriptEntry">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                <TextBlock Grid.Column="1" Text="asks first" FontSize="11" Foreground="{StaticResource AmberBrush}"
                           IsVisible="{Binding Confirm}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Border>
    </DockPanel>

    <!-- selected script -->
    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Top" Spacing="10" IsVisible="{Binding HasScript}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{Binding Category}" Margin="0" />
            <TextBlock Text="{Binding EditName}" FontSize="20" FontWeight="SemiBold" IsVisible="{Binding IsBuiltIn}" TextWrapping="Wrap" />
            <TextBox Text="{Binding EditName}" FontSize="18" IsVisible="{Binding IsMine}" PlaceholderText="Script name" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="12,0,0,0">
            <Button Content="Copy to My scripts" Command="{Binding CopyToMineCommand}" IsVisible="{Binding IsBuiltIn}"
                    ToolTip.Tip="Make your own editable version of this script" />
            <Button Content="Delete" Command="{Binding DeleteScriptCommand}" IsVisible="{Binding IsMine}" />
          </StackPanel>
        </Grid>

        <TextBlock Classes="dim" Text="{Binding EditDescription}" TextWrapping="Wrap" IsVisible="{Binding IsBuiltIn}" />
        <TextBox Text="{Binding EditDescription}" PlaceholderText="What does it do? (optional)" IsVisible="{Binding IsMine}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Warning}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding HasWarning}" />

        <StackPanel>
          <TextBlock Classes="label" Text="Commands: one per line. # starts a comment. {name} or {name=default} asks for a value when it runs." />
          <TextBox Classes="mono" Text="{Binding EditCommands}" AcceptsReturn="True" TextWrapping="NoWrap"
                   Height="112" IsReadOnly="{Binding IsBuiltIn}"
                   PlaceholderText="adb shell dumpsys deviceidle disable" />
          <CheckBox Content="Ask before running" IsChecked="{Binding EditConfirm}" IsVisible="{Binding IsMine}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasFields}">
          <TextBlock Classes="label" Text="Values" />
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FieldInput">
                <Grid ColumnDefinitions="140,*" Margin="0,0,0,6">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="{Binding Hint}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
          <Button Classes="accent" Content="{Binding RunLabel}" MinWidth="110" FontWeight="SemiBold" Command="{Binding RunCommand}"
                  ToolTip.Tip="Runs on the devices ticked on the right" />
          <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Text="{Binding RunStatus}"
                     Foreground="{Binding RunStatusBrush}" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Content="Open output folder" Command="{Binding OpenOutputFolderCommand}"
                  ToolTip.Tip="{Binding OutputFolder}" />
        </Grid>
      </StackPanel>

      <TextBlock DockPanel.Dock="Top" Classes="dim" Text="Pick a script on the left, or click + New to write your own."
                 IsVisible="{Binding !HasScript}" Margin="0,40,0,0" HorizontalAlignment="Center" />

      <Border Margin="0,14,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
              BorderThickness="1" CornerRadius="8">
        <TextBox Classes="mono" Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 Background="Transparent" BorderThickness="0" PlaceholderText="Output appears here."
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
      </Border>
    </DockPanel>

    <!-- devices to run on, in the same groups as the main window -->
    <DockPanel Grid.Column="4">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Height="32" Margin="0,0,0,10">
        <TextBlock Text="Run on" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="link" Content="All" Command="{Binding TickAllCommand}" />
        <Button Grid.Column="2" Classes="link" Content="None" Command="{Binding TickNoneCommand}" />
      </Grid>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
        <Panel>
          <TextBlock Classes="dim" Margin="16" TextWrapping="Wrap" IsVisible="{Binding NoTargets}"
                     Text="No devices on the network. Turn on Wireless debugging on a device, or connect one from the main window." />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding TargetGroups}" Margin="8,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TargetGroup">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="34" IsVisible="{Binding ShowHeader}">
                      <ToggleButton Classes="chev" IsChecked="{Binding IsExpanded}" ToolTip.Tip="Show or hide the devices">
                        <Panel Width="16" Height="16">
                          <Path Classes="chevron" Data="M4 6 L8 10 L12 6" IsVisible="{Binding IsExpanded}" />
                          <Path Classes="chevron" Data="M6 4 L10 8 L6 12" IsVisible="{Binding !IsExpanded}" />
                        </Panel>
                      </ToggleButton>
                      <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked}" IsEnabled="{Binding HasMembers}" Margin="4,0,0,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </CheckBox>
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Members}" Margin="{Binding MemberMargin}" IsVisible="{Binding MembersVisible}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TargetDevice">
                          <CheckBox IsChecked="{Binding IsChecked}" MinHeight="30">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Panel>
      </Border>
    </DockPanel>
  </Grid>
</Window>
