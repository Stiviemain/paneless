<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        x:Class="Paneless.App.Views.PromptWindow"
        Title="Paneless" Icon="/Assets/Paneless.ico"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20" Spacing="12">
    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Classes="dim" />
    <TextBox x:Name="Input" MaxLength="60" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="NoButton" Content="{l:T 'Cancel'}" IsCancel="True" />
      <Button x:Name="YesButton" Classes="accent" Content="{l:T 'OK'}" MinWidth="100" IsDefault="True" FontWeight="SemiBold" />
    </StackPanel>
  </StackPanel>
</Window>
