<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneless.App.ViewModels"
             xmlns:l="using:Paneless.App.Localization"
             x:Class="Paneless.App.Views.WallPage"
             x:DataType="vm:WallViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tile.dragging">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Image.off">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
    <!-- The corner to drag for resizing: faint until the pointer is on the tile. -->
    <Style Selector="Border.grip">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tile:pointerover Border.grip">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="3">
        <TextBlock Classes="pagetitle" Text="{l:T 'Wall'}" />
        <TextBlock Classes="pagehint" Text="{l:T 'A live picture of every connected device. Click one to mirror it, drag it to move it, drag its corner to resize it, right-click for more. Pictures are only taken while this page is open.'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="12,0,0,0">
        <Button Content="{Binding ShowHiddenText}" Command="{Binding ShowHiddenCommand}" IsVisible="{Binding !!HiddenCount}" />
        <ComboBox Width="160" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding GroupFilter}" />
        <ComboBox Width="90" ItemsSource="{Binding SecondChoices}" SelectedItem="{Binding Seconds}" ToolTip.Tip="{l:T 'Seconds between pictures'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Int32">
              <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ToggleButton Content="{l:T 'Pause'}" IsChecked="{Binding IsPaused}" />
      </StackPanel>
    </Grid>

    <Panel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WallTile">
              <Button Classes="tile" Classes.dragging="{Binding IsDragging}" Width="{Binding Width}" ToolTip.Tip="{l:T 'Click to mirror. Right-click for more.'}">
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{l:T 'Mirror'}" Command="{Binding Wall.MirrorCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" IsVisible="{Binding !IsMirroring}" />
                    <MenuItem Header="{l:T 'Show the mirror window'}" Command="{Binding Wall.MirrorCommand}" CommandParameter="{Binding}" FontWeight="SemiBold" IsVisible="{Binding IsMirroring}" />
                    <MenuItem Header="{l:T 'Wake the screen'}" Command="{Binding Wall.WakeCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Unlock now'}" Command="{Binding Wall.UnlockCommand}" CommandParameter="{Binding}" IsVisible="{Binding CanUnlock}" />
                    <MenuItem Header="{l:T 'Turn the screen off'}" Command="{Binding Wall.TurnScreenOffCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="{l:T 'Refresh the picture'}" Command="{Binding Wall.RefreshPictureCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Save a screenshot'}" Command="{Binding Wall.SaveScreenshotCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="{l:T 'Open a second screen'}" Command="{Binding Wall.SecondScreenCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Apps…'}" Command="{Binding Wall.AppsCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Files &amp; photos…'}" Command="{Binding Wall.FilesCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Locate device'}" Command="{Binding Wall.LocateCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="{l:T 'Device settings…'}" Command="{Binding Wall.DeviceSettingsCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="{l:T 'Size'}">
                      <MenuItem Header="{l:T 'Larger'}" Command="{Binding Wall.LargerCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="{l:T 'Smaller'}" Command="{Binding Wall.SmallerCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="{l:T 'Same size as the others'}" Command="{Binding Wall.SameSizeCommand}" CommandParameter="{Binding}" IsEnabled="{Binding HasOwnSize}" />
                      <MenuItem Header="{l:T 'Make all this size'}" Command="{Binding Wall.MakeAllThisSizeCommand}" CommandParameter="{Binding}" />
                    </MenuItem>
                    <MenuItem Header="{l:T 'Move'}">
                      <MenuItem Header="{l:T 'To the start'}" Command="{Binding Wall.MoveFirstCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="{l:T 'Left'}" Command="{Binding Wall.MoveLeftCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="{l:T 'Right'}" Command="{Binding Wall.MoveRightCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="{l:T 'To the end'}" Command="{Binding Wall.MoveLastCommand}" CommandParameter="{Binding}" />
                      <Separator />
                      <MenuItem Header="{l:T 'Sort all by name'}" Command="{Binding Wall.SortByNameCommand}" />
                    </MenuItem>
                    <MenuItem Header="{l:T 'Hide from the Wall'}" Command="{Binding Wall.HideCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Button.ContextMenu>
                <Panel>
                  <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="10,6,22,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="small" Text="{Binding Status}" Margin="6,0,0,0" />
                    </Grid>
                    <Panel MinHeight="120">
                      <Image Source="{Binding Image}" Classes.off="{Binding ScreenOff}" Stretch="Uniform" Margin="6,6,6,0" MaxHeight="{Binding MaxImageHeight}" />
                      <TextBlock Classes="dim" Text="{l:T 'Waiting for a picture…'}" IsVisible="{Binding ShowWaiting}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                      <StackPanel IsVisible="{Binding ScreenOff}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock Text="{l:T 'Screen off'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <Button Content="{l:T 'Wake'}" Command="{Binding Wall.WakeCommand}" CommandParameter="{Binding}" HorizontalAlignment="Center"
                                ToolTip.Tip="{l:T 'Turns the screen on. Pictures of a screen that is off would only be black.'}" />
                      </StackPanel>
                      <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                              IsVisible="{Binding IsMirroring}">
                        <TextBlock Text="{l:T 'Mirroring'}" FontSize="11" Foreground="White" />
                      </Border>
                    </Panel>
                  </DockPanel>
                  <Border Classes="grip" Width="20" Height="20" Background="Transparent" Cursor="BottomRightCorner"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip.Tip="{l:T 'Drag to resize'}">
                    <Path Data="M 13,3 L 3,13 M 13,8 L 8,13" Stroke="{DynamicResource DimBrush}" StrokeThickness="1.5" StrokeLineCap="Round"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
                  </Border>
                </Panel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Classes="dim" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 Text="{l:T 'No connected devices. Devices appear here as soon as they are connected.'}" />
      <TextBlock Classes="dim" IsVisible="{Binding AllHidden}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 Text="{l:T 'Every connected device is hidden from the Wall.'}" />
    </Panel>
  </DockPanel>
</UserControl>
