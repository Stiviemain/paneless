<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneless.App.ViewModels"
             xmlns:l="using:Paneless.App.Localization"
             x:Class="Paneless.App.Views.WallPage"
             x:DataType="vm:WallViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Spacing="3">
        <TextBlock Classes="pagetitle" Text="{l:T 'Wall'}" />
        <TextBlock Classes="pagehint" Text="{l:T 'A live picture of every connected device. Click one to mirror it. Pictures are only taken while this page is open.'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <ComboBox Width="160" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding GroupFilter}" />
        <ComboBox Width="110" ItemsSource="{Binding SizeChoices}" SelectedItem="{Binding Size}" ToolTip.Tip="{l:T 'Picture size'}" />
        <ComboBox Width="90" ItemsSource="{Binding SecondChoices}" SelectedItem="{Binding Seconds}" ToolTip.Tip="{l:T 'Seconds between pictures'}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Int32">
              <TextBlock Text="{Binding StringFormat='{}{0} s'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ToggleButton Content="{l:T 'Pause'}" IsChecked="{Binding IsPaused}" />
      </StackPanel>
    </Grid>

    <Panel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WallTile">
              <Button Classes="tile" Width="{Binding Width}" Command="{Binding $parent[ItemsControl].((vm:WallViewModel)DataContext).MirrorCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{l:T 'Mirror this device'}">
                <DockPanel>
                  <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="10,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Classes="small" Text="{Binding Status}" Margin="6,0,0,0" />
                  </Grid>
                  <Panel MinHeight="120">
                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="6,6,6,0" MaxHeight="520" />
                    <TextBlock Classes="dim" Text="{l:T 'Waiting for a picture…'}" IsVisible="{Binding !HasImage}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Padding="6,1" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsVisible="{Binding IsMirroring}">
                      <TextBlock Text="{l:T 'Mirroring'}" FontSize="11" Foreground="White" />
                    </Border>
                  </Panel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Classes="dim" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 Text="{l:T 'No connected devices. Devices appear here as soon as they are connected.'}" />
    </Panel>
  </DockPanel>
</UserControl>
