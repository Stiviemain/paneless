<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        x:Class="Paneless.App.Views.AssistantConfirmWindow"
        Title="Paneless" Icon="/Assets/Paneless.ico"
        Width="480" SizeToContent="Height" CanResize="False" Topmost="True"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="24,20" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <TextBlock Text="✦" FontSize="20" Foreground="#d97757" VerticalAlignment="Center" />
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <TextBlock Classes="small" TextWrapping="Wrap" Text="{l:T 'You can change what AI assistants may do, or pause them, on the AI page.'}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="DenyButton" Content="{l:T 'Don’t allow'}" IsCancel="True" />
      <Button x:Name="For15Button" Content="{l:T 'Allow for 15 minutes'}" />
      <Button x:Name="OnceButton" Classes="accent" Content="{l:T 'Allow once'}" IsDefault="True" FontWeight="SemiBold" />
    </StackPanel>
  </StackPanel>
</Window>
