<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paneless.App.ViewModels"
        xmlns:app="using:Paneless.App"
        x:Class="Paneless.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Paneless settings" Icon="/Assets/Paneless.ico"
        Width="820" Height="680" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style Selector="Button.linkish">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#8db4ff" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="22,18">
    <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                 Text="Devices and groups can have their own settings: right-click a device › Device settings, or a group's ⋯ › Group settings." />
      <Button Grid.Column="1" x:Name="CloseButton" Classes="accent" Content="Done" MinWidth="90" IsCancel="True" IsDefault="True" Margin="12,0,0,0" />
    </Grid>

    <Grid ColumnDefinitions="*,24,*">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Mirroring (for every device)" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingRow">
                <Grid ColumnDefinitions="170,*" Margin="0,0,0,8" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="label" Text="Folder on the device for files you drop on it" Margin="0,6,0,0" />
          <TextBox Text="{Binding PushTarget}" PlaceholderText="/sdcard/Download/" />
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="Connecting" />
          <CheckBox Content="Connect to known devices by themselves" IsChecked="{Binding AutoConnect}"
                    ToolTip.Tip="Devices you've paired before are connected as soon as they show up on the network. On Android 17, wireless debugging also turns itself back on when the device returns to a trusted Wi-Fi." />

          <TextBlock Classes="section" Text="Start-up and notification area" Margin="0,10,0,4" />
          <CheckBox Content="Start Paneless with Windows (in the notification area)" IsChecked="{Binding StartWithSystem}"
                    IsVisible="{Binding AutostartSupported}" />
          <CheckBox Content="Keep running in the notification area when the window is closed" IsChecked="{Binding CloseToTray}"
                    ToolTip.Tip="Shortcuts, auto-connect and on-connect scripts keep working. Quit from the notification-area icon." />

          <TextBlock Classes="section" Text="Updates" Margin="0,10,0,4" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Where new versions are published: a web address or a folder with the releases (e.g. a shared folder). Leave empty for no update checks." />
          <TextBox Text="{Binding UpdateSource}" PlaceholderText="https://… or C:\…\releases" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Check for updates now" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsChecking}" />
            <TextBlock Text="{Binding UpdateStatus}" Classes="dim" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
          </StackPanel>

          <TextBlock Classes="section" Text="Support Paneless" Margin="0,10,0,4" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="Paneless is free and open source. If it saves you time, you can support its development. It never asks by itself." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Tag="{x:Static app:AppLinks.KoFi}" Click="OpenLink" ToolTip.Tip="ko-fi.com/Stiviemain: a one-off coffee, no account needed">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="☕" />
                <TextBlock Text="Buy me a coffee on Ko-fi" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Classes="linkish" Tag="{x:Static app:AppLinks.Repository}" Click="OpenLink" Content="Paneless on GitHub: star it, report a bug, suggest an idea" Padding="0,4" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
