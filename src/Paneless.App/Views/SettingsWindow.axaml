<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        xmlns:app="using:Paneless.App"
        x:Class="Paneless.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{l:T 'Paneless settings'}" Icon="/Assets/Paneless.ico"
        Width="840" Height="720" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style Selector="Button.linkish">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="22,18">
    <TextBlock DockPanel.Dock="Top" Text="{l:T 'Settings'}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                 Text="{l:T 'Devices and groups can have their own settings: right-click a device › Device settings, or a group’s ⋯ › Group settings.'}" />
      <Button Grid.Column="1" x:Name="CloseButton" Classes="accent" Content="{l:T 'Done'}" MinWidth="90" IsCancel="True" IsDefault="True" Margin="12,0,0,0" />
    </Grid>

    <Grid ColumnDefinitions="*,24,*">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,14,0">
          <TextBlock Classes="section" Text="{l:T 'Mirroring (for every device)'}" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingRow">
                <Grid ColumnDefinitions="170,*" Margin="0,0,0,8" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="label" Text="{l:T 'Folder on the device for files you drop on it'}" Margin="0,6,0,0" />
          <TextBox Text="{Binding PushTarget}" PlaceholderText="{l:T '/sdcard/Download/'}" />
          <TextBlock Classes="section" Text="{l:T 'Background sync'}" Margin="0,12,0,4" />
          <ItemsControl ItemsSource="{Binding SyncRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingRow">
                <Grid ColumnDefinitions="170,*" Margin="0,0,0,8" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" Margin="0,0,14,0">
          <TextBlock Classes="section" Text="{l:T 'Connecting'}" />
          <CheckBox Content="{l:T 'Connect to known devices by themselves'}" IsChecked="{Binding AutoConnect}"
                    ToolTip.Tip="{l:T 'Devices you’ve paired before are connected as soon as they show up on the network. On Android 17, wireless debugging also turns itself back on when the device returns to a trusted Wi-Fi.'}" />

          <TextBlock Classes="section" Text="{l:T 'Start-up and notification area'}" Margin="0,10,0,4" />
          <CheckBox Content="{l:T 'Start Paneless with Windows (in the notification area)'}" IsChecked="{Binding StartWithSystem}"
                    IsVisible="{Binding AutostartSupported}" />
          <CheckBox Content="{l:T 'Keep running in the notification area when the window is closed'}" IsChecked="{Binding CloseToTray}"
                    ToolTip.Tip="{l:T 'Shortcuts, auto-connect and on-connect scripts keep working. Quit from the notification-area icon.'}" />

          <TextBlock Classes="section" Text="{l:T 'Appearance'}" Margin="0,10,0,4" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding Theme}" />

          <TextBlock Classes="section" Text="{l:T 'Language'}" Margin="0,10,0,4" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}" />
          <TextBlock Classes="label" TextWrapping="Wrap" Text="{Binding LanguageNote}" IsVisible="{Binding LanguageChanged}" Foreground="{DynamicResource AmberBrush}" />

          <TextBlock Classes="section" Text="{l:T 'Updates'}" Margin="0,10,0,4" />
          <CheckBox Content="{l:T 'Install new versions automatically (from GitHub)'}" IsChecked="{Binding AutoUpdate}"
                    ToolTip.Tip="{l:T 'Paneless looks for a new version at start-up and every few hours, downloads it in the background and installs it when you close Paneless.'}" />
          <CheckBox Content="{l:T 'Include beta versions'}" IsChecked="{Binding BetaUpdates}" />
          <Expander Header="{l:T 'Other update source'}" Padding="0,6,0,0">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="{l:T 'Only if your organisation publishes its own builds: a web address or a folder with the releases. Leave empty for GitHub.'}" />
              <TextBox Text="{Binding UpdateSource}" PlaceholderText="{l:T 'https://… or C:\…\releases'}" />
            </StackPanel>
          </Expander>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{l:T 'Check for updates now'}" Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !IsChecking}" />
            <TextBlock Text="{Binding UpdateStatus}" Classes="dim" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
          </StackPanel>

          <TextBlock Classes="section" Text="{l:T 'Backup and reset'}" Margin="0,10,0,4" />
          <CheckBox IsChecked="{Binding ExportIncludeDevices}"
                    ToolTip.Tip="{l:T 'When unchecked, only Paneless settings, scripts and automation are exported. Unlock codes are never exported.'}">
            <TextBlock Text="{l:T 'Also include saved devices, groups, device settings and remote apps'}" TextWrapping="Wrap" />
          </CheckBox>
          <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Button Content="{l:T 'Export settings…'}" Command="{Binding ExportSettingsCommand}" Margin="0,0,8,8" />
            <Button Content="{l:T 'Import settings…'}" Command="{Binding ImportSettingsCommand}" Margin="0,0,8,8" />
            <Button Content="{l:T 'Reset to defaults…'}" Command="{Binding ResetToDefaultsCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock Text="{Binding BackupStatus}" Foreground="{Binding BackupStatusBrush}"
                     IsVisible="{Binding HasBackupStatus}" FontSize="12" TextWrapping="Wrap" />

          <TextBlock Classes="section" Text="{l:T 'Support Paneless'}" Margin="0,10,0,4" />
          <TextBlock Classes="label" TextWrapping="Wrap"
                     Text="{l:T 'Paneless is free and open source. If it saves you time, you can support its development. It never asks by itself.'}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Tag="{x:Static app:AppLinks.KoFi}" Click="OpenLink" ToolTip.Tip="{l:T 'ko-fi.com/Stiviemain: a one-off coffee, no account needed'}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="☕" />
                <TextBlock Text="{l:T 'Buy me a coffee on Ko-fi'}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <Button Classes="linkish" Tag="{x:Static app:AppLinks.Repository}" Click="OpenLink" Content="{l:T 'Paneless on GitHub: star it, report a bug, suggest an idea'}" Padding="0,4" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
