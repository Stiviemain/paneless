<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        x:Class="Paneless.App.Views.KeymapEditor"
        Title="{l:T 'Key mapping'}" Icon="/Assets/Paneless.ico"
        Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="18,14">
    <!-- profile -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="dim" FontSize="12"
                   Text="{l:T 'Profiles are layouts of keys. Each device uses one; make one per game.'}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <ComboBox x:Name="ProfileBox" Width="200" />
        <TextBox x:Name="NameBox" Width="190" PlaceholderText="{l:T 'Profile name'}" />
        <Button x:Name="NewButton" Content="{l:T 'New profile'}" />
        <Button x:Name="DeleteButton" Content="{l:T 'Delete'}" />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddTapButton" Content="{l:T '+ Tap key'}" ToolTip.Tip="{l:T 'Then click where the button is on the screen'}" />
        <Button x:Name="AddJoyButton" Content="{l:T '+ Movement joystick'}" ToolTip.Tip="{l:T 'Then click the centre of the game’s joystick'}" />
        <Button x:Name="RemoveButton" Content="{l:T 'Remove selected'}" />
        <Button x:Name="ShotButton" Content="{l:T 'New screenshot'}" ToolTip.Tip="{l:T 'Take a fresh screenshot of the device (e.g. after starting the game)'}" />
      </StackPanel>
      <StackPanel x:Name="JoyPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="18,0,0,0" IsVisible="False">
        <TextBlock Classes="dim" Text="{l:T 'Keys'}" VerticalAlignment="Center" />
        <ComboBox x:Name="JoyKeysBox" Width="140" />
        <TextBlock Classes="dim" Text="{l:T 'Size'}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <Slider x:Name="RadiusSlider" Width="140" Minimum="0.04" Maximum="0.25" />
      </StackPanel>
      <CheckBox x:Name="UseBox" Grid.Column="2" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" x:Name="HintText" Margin="0,12,0,8" TextWrapping="Wrap" />
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Classes="dim" Margin="0,10,0,0" TextWrapping="Wrap" />

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
      <Panel>
        <Viewbox Stretch="Uniform" Margin="10">
          <Grid x:Name="Surface" Width="1080" Height="2400">
            <Image x:Name="Shot" Stretch="Fill" />
            <Canvas x:Name="Overlay" Background="Transparent" />
          </Grid>
        </Viewbox>
        <TextBlock x:Name="LoadingText" Classes="dim" Text="{l:T 'Taking a screenshot of the device…'}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>
    </Border>
  </DockPanel>
</Window>
