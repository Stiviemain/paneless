<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Paneless.App.Localization"
             xmlns:vm="using:Paneless.App.ViewModels"
             x:Class="Paneless.App.Views.MirrorToolbarStrip"
             x:DataType="vm:ToolbarViewModel">

  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tool.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelBrush}" />
    </Style>
    <Style Selector="Button.tool.rec Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource RedBrush}" />
      <Setter Property="Fill" Value="{DynamicResource RedBrush}" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Border.sep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel x:Name="StripRoot">
    <Popup x:Name="Toast" PlacementTarget="{Binding #StripRoot}" Placement="LeftEdgeAlignedTop" HorizontalOffset="-6" VerticalOffset="6"
           IsLightDismissEnabled="True">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="8" Padding="12,9" MaxWidth="340">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" FontSize="13" />
      </Border>
    </Popup>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
      <StackPanel Margin="4,6" Spacing="2" HorizontalAlignment="Center">
        <!-- Navigation -->
        <Button Classes="tool" Command="{Binding BackCommand}" ToolTip.Tip="{l:T 'Back'}">
          <Path Classes="icon" Data="M16 5 L7 12 L16 19 Z" />
        </Button>
        <Button Classes="tool" Command="{Binding HomeCommand}" ToolTip.Tip="{l:T 'Home'}">
          <Path Classes="icon" Data="M12 5 A7 7 0 1 1 11.99 5 Z" />
        </Button>
        <Button Classes="tool" Command="{Binding RecentsCommand}" ToolTip.Tip="{l:T 'Recent apps'}">
          <Path Classes="icon" Data="M6.5 6.5 H17.5 V17.5 H6.5 Z" />
        </Button>

        <Border Classes="sep" />

        <!-- Hardware & power -->
        <Button Classes="tool" Command="{Binding VolumeUpCommand}" ToolTip.Tip="{l:T 'Volume up'}">
          <Path Classes="icon" Data="M3 9.5 H7 L12 5.5 V18.5 L7 14.5 H3 Z M16 12 H21 M18.5 9.5 V14.5" />
        </Button>
        <Button Classes="tool" Command="{Binding VolumeDownCommand}" ToolTip.Tip="{l:T 'Volume down'}">
          <Path Classes="icon" Data="M3 9.5 H7 L12 5.5 V18.5 L7 14.5 H3 Z M16 12 H21" />
        </Button>
        <Button Classes="tool" Command="{Binding PowerCommand}" IsVisible="{Binding IsPrimary}" ToolTip.Tip="{l:T 'Power button (screen on/off, locks the device)'}">
          <Path Classes="icon" Data="M7.8 7 A7 7 0 1 0 16.2 7 M12 3.5 V11" />
        </Button>
        <Button Classes="tool" Classes.on="{Binding IsScreenOff}" IsVisible="{Binding IsPrimary}" Command="{Binding ToggleScreenOffCommand}"
                ToolTip.Tip="{l:T 'Device screen off while mirroring (click again to turn it on)'}">
          <Path Classes="icon" Data="M7.5 3.5 H16.5 V20.5 H7.5 Z M4.5 4.5 L19.5 19.5" />
        </Button>

        <Border Classes="sep" />

        <!-- Display & capture -->
        <Button Classes="tool" Command="{Binding RotateCommand}" IsVisible="{Binding IsPrimary}"
                ToolTip.Tip="{l:T 'Rotate the device (portrait ↔ landscape). Locks it there until you close the mirror.'}">
          <Path Classes="icon" Data="M18.5 8.5 A7 7 0 1 0 19 13.5 M18.5 3.5 V8.5 H13.5" />
        </Button>
        <Button Classes="tool" Command="{Binding MoveToPhoneCommand}" IsVisible="{Binding IsSecondary}"
                ToolTip.Tip="{l:T 'Send this app back to the device’s own screen and close this window'}">
          <Path Classes="icon" Data="M8 4 H16 V20 H8 Z M4 12 H12 M9 9 L12 12 L9 15" />
        </Button>
        <Button Classes="tool" Command="{Binding ScreenshotCommand}" IsVisible="{Binding IsPrimary}"
                ToolTip.Tip="{l:T 'Screenshot to this computer (saved in Documents\Paneless and shown in Explorer)'}">
          <Path Classes="icon" Data="M4 8 H8 L9.5 5.5 H14.5 L16 8 H20 V18.5 H4 Z M12 10 A3 3 0 1 1 11.99 10 Z" />
        </Button>
        <Button Classes="tool" Classes.rec="{Binding IsRecording}" Command="{Binding RecordCommand}"
                ToolTip.Tip="{l:T 'Record the screen to a video file (Documents\Paneless). Click again to stop.'}">
          <Path Classes="icon" Data="M12 6 A6 6 0 1 1 11.99 6 Z M12 9.5 A2.5 2.5 0 1 1 11.99 9.5 Z" />
        </Button>

        <Border Classes="sep" />

        <!-- Active live modes (quick off-switch when active) & labeled overflow menu -->
        <Button Classes="tool on" Command="{Binding ToggleGroupControlCommand}" IsVisible="{Binding IsGroupControl}"
                ToolTip.Tip="{l:T 'Group control: taps, swipes, scrolling, typing and these buttons also happen on the other connected devices of this device’s group'}">
          <Path Classes="icon" Data="M4 5.5 H11 V16.5 H4 Z M13 7.5 H20 V18.5 H13 Z M11 11 H13" />
        </Button>
        <Button Classes="tool on" Command="{Binding ToggleKeymapCommand}" IsVisible="{Binding IsKeymapOn}"
                ToolTip.Tip="{l:T 'Key mapping on/off: use your keyboard as touches (for games)'}">
          <Path Classes="icon" Data="M3 7 H21 V17 H3 Z M6.5 10.5 H7.5 M10 10.5 H11 M13 10.5 H14 M16.5 10.5 H17.5 M7.5 14 H16.5" />
        </Button>

        <Button x:Name="MoreButton" Classes="tool" ToolTip.Tip="{l:T 'More tools'}">
          <Path Width="24" Height="24" Fill="{DynamicResource TextBrush}"
                Data="M5 12 A1 1 0 1 1 4.99 12 Z M12 12 A1 1 0 1 1 11.99 12 Z M19 12 A1 1 0 1 1 18.99 12 Z" />
          <Button.Flyout>
            <MenuFlyout Placement="LeftEdgeAlignedBottom">
              <MenuItem Header="{l:T 'Open notifications'}" Command="{Binding NotificationsCommand}" IsVisible="{Binding IsPrimary}" />
              <MenuItem Header="{l:T 'Open quick settings'}" Command="{Binding QuickSettingsCommand}" IsVisible="{Binding IsPrimary}" />
              <MenuItem Header="{l:T 'Type clipboard text'}" Command="{Binding TypeClipboardCommand}" />
              <Separator IsVisible="{Binding ShowMainDisplayItems}" />
              <MenuItem Header="{l:T 'Open a second screen'}" Command="{Binding SecondScreenCommand}" IsVisible="{Binding ShowSecondScreen}" />
              <MenuItem Header="{l:T 'Pop out current app'}" Command="{Binding PopOutAppCommand}" IsVisible="{Binding ShowPopOutApp}" />
              <MenuItem Header="{l:T 'Back camera'}" Command="{Binding CameraCommand}" IsVisible="{Binding ShowCamera}" />
              <Separator IsVisible="{Binding HasMainHost}" />
              <MenuItem Header="{l:T 'Quick controls &amp; media…'}" Command="{Binding QuickControlsCommand}" IsVisible="{Binding ShowQuickControls}" />
              <MenuItem Header="{l:T 'Run a script…'}" Command="{Binding ScriptsCommand}" IsVisible="{Binding ShowScripts}" />
              <Separator IsVisible="{Binding ShowLiveModes}" />
              <MenuItem Header="{Binding GroupControlMenuLabel}" Command="{Binding ToggleGroupControlCommand}" IsVisible="{Binding ShowGroupControl}" />
              <MenuItem Header="{Binding KeymapMenuLabel}" Command="{Binding ToggleKeymapCommand}" IsVisible="{Binding ShowKeymap}" />
              <MenuItem Header="{l:T 'Set up key mapping…'}" Command="{Binding EditKeymapCommand}" IsVisible="{Binding ShowKeymap}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </ScrollViewer>
  </Panel>
</UserControl>
