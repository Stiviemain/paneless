<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Paneless.App.ViewModels"
             xmlns:l="using:Paneless.App.Localization"
             x:Class="Paneless.App.Views.AutomationPage"
             x:DataType="vm:AutomationViewModel">
  <UserControl.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,6">
      <TextBlock Classes="pagetitle" Text="{l:T 'Automation'}" />
      <TextBlock Classes="pagehint" Text="{l:T 'Set devices up in one go, let tasks run by themselves, and get told when something needs attention.'}" />
    </StackPanel>

    <TabControl Padding="0,8,0,0">

      <!-- ============================================================ recipes -->
      <TabItem Header="{l:T 'Recipes'}">
        <Grid ColumnDefinitions="250,16,*" DataContext="{Binding Recipes}" x:DataType="vm:RecipesViewModel">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Button Content="{l:T '+ New'}" Command="{Binding NewCommand}" />
              <Button Content="{l:T 'Duplicate'}" Command="{Binding DuplicateCommand}" IsEnabled="{Binding HasRecipe}" />
              <Button Content="{l:T 'Delete'}" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasRecipe}" />
            </StackPanel>
            <Border Classes="card" ClipToBounds="True">
              <Panel>
                <ListBox Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecipeItem">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="small" Text="{Binding Summary}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="dim" IsVisible="{Binding NoRecipes}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16"
                           Text="{l:T 'A recipe is a list of apps, files, scripts and commands that sets a device up in one go. Click + New.'}" />
              </Panel>
            </Border>
          </DockPanel>

          <DockPanel Grid.Column="2" IsVisible="{Binding HasRecipe}">
            <StackPanel DockPanel.Dock="Top" Spacing="8">
              <Grid ColumnDefinitions="*,12,2*">
                <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'Recipe name'}" FontSize="15" />
                <TextBox Grid.Column="2" Text="{Binding Description}" PlaceholderText="{l:T 'What it sets up (optional)'}" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="fieldlabel" Text="{l:T 'Add a step:'}" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Classes="flat" Content="{l:T '+ App (APK)'}" Command="{Binding AddApkCommand}" />
                <Button Classes="flat" Content="{l:T '+ File'}" Command="{Binding AddFileCommand}" />
                <Button Classes="flat" Content="{l:T '+ Script'}" Command="{Binding AddScriptCommand}" />
                <Button Classes="flat" Content="{l:T '+ Command'}" Command="{Binding AddCommandCommand}" />
                <Button Classes="flat" Content="{l:T '+ Restart'}" Command="{Binding AddRebootCommand}" />
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Classes="fieldlabel" Text="{l:T 'Run on'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" />
                <CheckBox Grid.Column="2" Margin="12,0" Content="{l:T 'Keep going after a failed step'}" IsChecked="{Binding ContinueOnError}" />
                <Button Grid.Column="3" Classes="accent" MinWidth="100" Content="{l:T 'Run'}" Command="{Binding RunCommand}" IsEnabled="{Binding !IsRunning}" />
              </Grid>
              <TextBlock Classes="small" Text="{Binding Status}" TextWrapping="Wrap" />
              <Border Classes="card" MaxHeight="130" IsVisible="{Binding !!Output.Count}">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding Output}" Margin="10,6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="Cascadia Mono, Consolas, monospace" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <Border Classes="card" Margin="0,10,0,0">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Steps}" Margin="10,8">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepItem">
                      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                        <Grid ColumnDefinitions="140,*,Auto">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="6">
                            <Grid ColumnDefinitions="*,6,Auto" IsVisible="{Binding HasPath}">
                              <TextBox Text="{Binding Path}" PlaceholderText="{l:T 'File on this computer'}" />
                              <Button Grid.Column="2" Content="…" Command="{Binding $parent[ItemsControl].((vm:RecipesViewModel)DataContext).BrowseCommand}" CommandParameter="{Binding}" />
                            </Grid>
                            <TextBlock Classes="small" Foreground="{DynamicResource AmberBrush}" Text="{l:T 'This file doesn’t exist (any more).'}" IsVisible="{Binding FileMissing}" />
                            <TextBox Text="{Binding Target}" IsVisible="{Binding HasTarget}" PlaceholderText="{l:T 'Folder on the device (empty: the device’s drop folder)'}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Scripts}" SelectedItem="{Binding Script}" IsVisible="{Binding HasScript}"
                                      PlaceholderText="{l:T 'Choose a script'}" />
                            <TextBox Text="{Binding Command}" IsVisible="{Binding HasCommand}" FontFamily="Cascadia Mono, Consolas, monospace" PlaceholderText="{l:T 'adb shell …'}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                            <Button Classes="flat" Content="↑" ToolTip.Tip="{l:T 'Move up'}" Command="{Binding $parent[ItemsControl].((vm:RecipesViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                            <Button Classes="flat" Content="↓" ToolTip.Tip="{l:T 'Move down'}" Command="{Binding $parent[ItemsControl].((vm:RecipesViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
                            <Button Classes="flat" Content="✕" ToolTip.Tip="{l:T 'Remove'}" Command="{Binding $parent[ItemsControl].((vm:RecipesViewModel)DataContext).RemoveStepCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ============================================================ scheduled tasks -->
      <TabItem Header="{l:T 'Scheduled tasks'}">
        <Grid ColumnDefinitions="280,16,*" DataContext="{Binding Schedules}" x:DataType="vm:SchedulesViewModel">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
              <Button Content="{l:T '+ New'}" Command="{Binding NewCommand}" />
              <Button Content="{l:T 'Delete'}" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasTask}" />
            </StackPanel>
            <Border Classes="card" ClipToBounds="True">
              <Panel>
                <ListBox Classes="plain" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleItem">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="small" Text="{Binding When}" />
                        <TextBlock Classes="small" Text="{Binding Next}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="dim" IsVisible="{Binding NoTasks}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="16"
                           Text="{l:T 'Let scripts, recipes, restarts or commands run by themselves, e.g. restart the lobby tablets every night. Click + New.'}" />
              </Panel>
            </Border>
          </DockPanel>

          <ScrollViewer Grid.Column="2" IsVisible="{Binding HasTask}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding Name}" PlaceholderText="{l:T 'Task name'}" FontSize="15" />
                <ToggleSwitch Grid.Column="1" Margin="12,0,0,0" IsChecked="{Binding Enabled}" OnContent="{l:T 'On'}" OffContent="{l:T 'Off'}" />
              </Grid>

              <StackPanel>
                <TextBlock Classes="fieldlabel" Text="{l:T 'What'}" />
                <Grid ColumnDefinitions="200,8,*">
                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ActionChoices}" SelectedItem="{Binding Action}" />
                  <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding TargetChoice}" IsVisible="{Binding ShowTargetChoice}" />
                  <TextBox Grid.Column="2" Text="{Binding Command}" IsVisible="{Binding ShowCommand}" FontFamily="Cascadia Mono, Consolas, monospace" PlaceholderText="{l:T 'adb shell …'}" />
                </Grid>
              </StackPanel>

              <StackPanel>
                <TextBlock Classes="fieldlabel" Text="{l:T 'On which groups'}" />
                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="16" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupPick">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="small" Text="{l:T 'Make groups on the Devices page (Groups…).'}" IsVisible="{Binding !Groups.Count}" />
              </StackPanel>

              <StackPanel>
                <TextBlock Classes="fieldlabel" Text="{l:T 'When'}" />
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                  <ComboBox Width="180" ItemsSource="{Binding RepeatChoices}" SelectedItem="{Binding Repeat}" />
                  <TextBox Width="80" Text="{Binding Time}" IsVisible="{Binding ShowTime}" PlaceholderText="03:00" ToolTip.Tip="{l:T 'Time of day, e.g. 03:00'}" />
                  <NumericUpDown Width="130" Value="{Binding Hours}" Minimum="1" Maximum="168" IsVisible="{Binding ShowHours}" FormatString="0" />
                  <TextBlock Classes="small" Text="{l:T 'hours'}" IsVisible="{Binding ShowHours}" VerticalAlignment="Center" />
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding ShowDays}" Margin="0,8,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayPick">
                      <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsChecked}" MinWidth="44" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Classes="small" Text="{Binding Selected.Last}" TextWrapping="Wrap" />
                <TextBlock Classes="small" Text="{Binding Hint}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="{l:T 'Run now'}" Command="{Binding RunNowCommand}" IsEnabled="{Binding !IsRunning}" />
                  <TextBlock Classes="small" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============================================================ alerts -->
      <TabItem Header="{l:T 'Alerts'}">
        <Grid ColumnDefinitions="*,16,*" DataContext="{Binding Alerts}" x:DataType="vm:AlertsViewModel">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
              <TextBlock Classes="heading" Text="{l:T 'What to watch'}" />
              <TextBlock Classes="small" Text="{Binding Hint}" TextWrapping="Wrap" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Classes="flat" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T 'Show a test notification'}" Command="{Binding TestNotificationCommand}" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RuleItem">
                    <Border Classes="card" Padding="12,10" Margin="0,0,0,8">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <CheckBox IsChecked="{Binding Enabled}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          </CheckBox>
                          <CheckBox Grid.Column="1" Content="{l:T 'Windows notification'}" IsChecked="{Binding Notify}" IsEnabled="{Binding Enabled}" />
                        </Grid>
                        <WrapPanel ItemSpacing="8" LineSpacing="6" IsEnabled="{Binding Enabled}">
                          <TextBlock Classes="small" Text="{Binding ThresholdLabel}" VerticalAlignment="Center" IsVisible="{Binding HasThreshold}" />
                          <NumericUpDown Width="110" Value="{Binding Threshold}" Minimum="1" Maximum="999" FormatString="0" IsVisible="{Binding HasThreshold}" />
                          <TextBlock Classes="small" Text="{l:T 'on'}" VerticalAlignment="Center" />
                          <ComboBox Width="170" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>

          <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Classes="heading" Text="{l:T 'What happened'}" />
              <Button Grid.Column="1" Classes="flat" Content="{l:T 'Clear'}" Command="{Binding ClearEventsCommand}" />
            </Grid>
            <Border Classes="card" ClipToBounds="True">
              <Panel>
                <ListBox Classes="plain" ItemsSource="{Binding Events}" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:EventItem">
                      <Grid ColumnDefinitions="26,*,Auto">
                        <TextBlock Text="{Binding Icon}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Classes="small" Text="{Binding Time}" Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="dim" IsVisible="{Binding NoEvents}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{l:T 'Nothing so far.'}" />
              </Panel>
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
