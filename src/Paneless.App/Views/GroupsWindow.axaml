<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.GroupsWindow"
        x:DataType="vm:GroupsViewModel"
        Title="{l:T 'Paneless groups'}" Icon="/Assets/Paneless.ico"
        Width="900" Height="600" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="ListBox.list ListBoxItem">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelBrush}" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20,18">
    <!-- message line and Close -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="CloseButton" Content="{l:T 'Close'}" MinWidth="90" IsCancel="True" />
    </Grid>

    <Grid ColumnDefinitions="260,20,*">

      <!-- groups -->
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="34" Margin="0,0,0,10">
          <TextBlock Text="{l:T 'Groups'}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="accent small" Content="{l:T '+ New group'}" Command="{Binding NewGroupCommand}" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
          <Button Classes="small" Content="{l:T 'Rename…'}" Command="{Binding RenameCommand}" />
          <Button Classes="small" Content="↑" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T 'Move up (order in the device list)'}" />
          <Button Classes="small" Content="↓" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T 'Move down'}" />
          <Button Classes="small" Content="{l:T 'Delete'}" Command="{Binding DeleteCommand}" />
        </StackPanel>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <Panel>
            <ListBox Classes="list" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupListItem">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock IsVisible="{Binding NoGroups}" Classes="dim" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="20"
                       Text="{l:T 'No groups yet. Click + New group, e.g. for Test lab or Family tablets.'}" />
          </Panel>
        </Border>
      </DockPanel>

      <!-- devices of the selected group -->
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="34" Margin="0,0,0,4">
          <TextBlock Text="{Binding DevicesTitle}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBox Grid.Column="1" Width="220" Text="{Binding Filter}" PlaceholderText="{l:T 'Filter devices'}" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="dim" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="{l:T 'Tick the devices that belong in this group. A device is in one group at a time, so ticking one that’s in another group moves it here.'}" />
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0" IsEnabled="{Binding HasGroup}">
          <Button Classes="small" Content="{Binding AddSelectedLabel}" Command="{Binding AddSelectedCommand}" />
          <Button Grid.Column="2" Classes="link" Content="{l:T 'Tick all shown'}" Command="{Binding TickAllShownCommand}" />
          <Button Grid.Column="3" Classes="link" Content="{l:T 'Untick all shown'}" Command="{Binding UntickAllShownCommand}" />
        </Grid>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGroup}">
              <ItemsControl ItemsSource="{Binding Devices}" Margin="10,6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupDeviceItem">
                    <Grid ColumnDefinitions="Auto,2*,1.6*,1.2*,Auto" MinHeight="34">
                      <CheckBox IsChecked="{Binding IsMember}" MinWidth="0" Margin="0,0,6,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0" />
                      <TextBlock Grid.Column="3" Text="{Binding WhereText}" Foreground="{DynamicResource AmberBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4" Text="{Binding OnlineText}" Foreground="{Binding OnlineBrush}" VerticalAlignment="Center" Margin="10,0,4,0"
                                 ToolTip.Tip="{l:T '● on the network now · ○ not on the network'}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock IsVisible="{Binding !HasGroup}" Classes="dim" TextAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap"
                       Text="{l:T 'Create a group on the left, then tick its devices here.'}" />
          </Panel>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
