<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Paneless.App.ViewModels"
        xmlns:app="using:Paneless.App"
        xmlns:views="using:Paneless.App.Views"
        xmlns:l="using:Paneless.App.Localization"
        x:Class="Paneless.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Icon="/Assets/Paneless.ico"
        Width="1100" Height="700" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Path.icon">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Path.chevron">
      <Setter Property="Stroke" Value="{DynamicResource DimBrush}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Group headings: the whole row is one button that collapses/expands the group. -->
    <Style Selector="Button.grouphead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.grouphead:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Width" Value="82" />
      <Setter Property="Height" Value="52" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelBrush}" />
    </Style>
    <Style Selector="Border.navpill">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="1,0,0,0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.nav.on Border.navpill">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.navsep">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="14,5" />
      <Setter Property="Background" Value="{DynamicResource LineBrush}" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Path.navicon">
      <Setter Property="Stroke" Value="{DynamicResource DimBrush}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="19" />
      <Setter Property="Height" Value="19" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover Path.navicon">
      <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.on Path.navicon">
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.navlabel">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover TextBlock.navlabel">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.on TextBlock.navlabel">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.brand">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.searchclear">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.searchclear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="Auto,*">

    <!-- navigation: daily views on top, tools & system utilities (Logs, Settings) at the bottom -->
    <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Width="90" Margin="0,10,0,10">
        <Button DockPanel.Dock="Top" Classes="brand" Margin="0,0,0,8" Command="{Binding GoCommand}" CommandParameter="Devices" ToolTip.Tip="Paneless">
          <Image Source="/Assets/Paneless.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </Button>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Border Classes="navsep" />
          <Button Classes="nav" Classes.on="{Binding IsLogsPage}" Command="{Binding GoCommand}" CommandParameter="Logs" ToolTip.Tip="Ctrl+7">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Panel Width="26" Height="19" HorizontalAlignment="Center">
                  <Path Classes="navicon" Data="M4 5.5 H20 M4 10 H16 M4 14.5 H20 M4 19 H13" />
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource AmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"
                           IsVisible="{Binding HasLogCrashes}" />
                </Panel>
                <TextBlock Classes="navlabel" Text="{l:T 'Logs'}" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="nav" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{l:T 'Settings'}">
            <Panel>
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M12 15 A3 3 0 1 0 12 9 A3 3 0 1 0 12 15 Z M19.4 15 A1.65 1.65 0 0 0 19.73 16.82 L19.79 16.88 A2 2 0 1 1 16.96 19.71 L16.9 19.65 A1.65 1.65 0 0 0 15.08 19.32 A1.65 1.65 0 0 0 14.08 20.83 V21 A2 2 0 1 1 10.08 21 V20.91 A1.65 1.65 0 0 0 9 19.4 A1.65 1.65 0 0 0 7.18 19.73 L7.12 19.79 A2 2 0 1 1 4.29 16.96 L4.35 16.9 A1.65 1.65 0 0 0 4.68 15.08 A1.65 1.65 0 0 0 3.17 14.08 H3 A2 2 0 1 1 3 10.08 H3.09 A1.65 1.65 0 0 0 4.6 9 A1.65 1.65 0 0 0 4.27 7.18 L4.21 7.12 A2 2 0 1 1 7.04 4.29 L7.1 4.35 A1.65 1.65 0 0 0 8.92 4.68 H9 A1.65 1.65 0 0 0 9.92 3.17 V3 A2 2 0 1 1 13.92 3 V3.09 A1.65 1.65 0 0 0 14.92 4.6 A1.65 1.65 0 0 0 16.74 4.27 L16.8 4.21 A2 2 0 1 1 19.63 7.04 L19.57 7.1 A1.65 1.65 0 0 0 19.24 8.92 V9 A1.65 1.65 0 0 0 20.75 9.92 H20.92 A2 2 0 1 1 20.92 13.92 H20.83 A1.65 1.65 0 0 0 19.32 14.92 Z" />
                <TextBlock Classes="navlabel" Text="{l:T 'Settings'}" />
              </StackPanel>
            </Panel>
          </Button>
        </StackPanel>

        <StackPanel Spacing="2">
          <Button Classes="nav" Classes.on="{Binding IsDevicesPage}" Command="{Binding GoCommand}" CommandParameter="Devices" ToolTip.Tip="Ctrl+1">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M7 3.5 H17 V20.5 H7 Z M10.5 17.5 H13.5" />
                <TextBlock Classes="navlabel" Text="{l:T 'Devices'}" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="nav" Classes.on="{Binding IsRemoteAppsPage}" Command="{Binding GoCommand}" CommandParameter="RemoteApps"
                  ToolTip.Tip="{l:T 'Android apps in windows of their own, with shortcuts'}">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M3.5 5 H20.5 V19 H3.5 Z M3.5 8.5 H20.5 M9 11.5 H15 V16.5 H9 Z" />
                <TextBlock Classes="navlabel" Text="{l:T 'Remote apps'}" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="nav" Classes.on="{Binding IsWallPage}" Command="{Binding GoCommand}" CommandParameter="Wall" ToolTip.Tip="Ctrl+3">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M3.5 4.5 H10.5 V11 H3.5 Z M13.5 4.5 H20.5 V11 H13.5 Z M3.5 13 H10.5 V19.5 H3.5 Z M13.5 13 H20.5 V19.5 H13.5 Z" />
                <TextBlock Classes="navlabel" Text="{l:T 'Wall'}" />
              </StackPanel>
            </Panel>
          </Button>
          <Border Classes="navsep" />
          <Button Classes="nav" Classes.on="{Binding IsAutomationPage}" Command="{Binding GoCommand}" CommandParameter="Automation" ToolTip.Tip="Ctrl+4">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M12 7.5 V12 L15 14" />
                <TextBlock Classes="navlabel" Text="{l:T 'Automation'}" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="nav" Classes.on="{Binding IsInventoryPage}" Command="{Binding GoCommand}" CommandParameter="Inventory" ToolTip.Tip="Ctrl+5">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Path Classes="navicon" Data="M5 4.5 H19 V20 H5 Z M8 9 H16 M8 12.5 H16 M8 16 H12.5" />
                <TextBlock Classes="navlabel" Text="{l:T 'Inventory'}" />
              </StackPanel>
            </Panel>
          </Button>
          <Button Classes="nav" Classes.on="{Binding IsAssistantsPage}" Command="{Binding GoCommand}" CommandParameter="Assistants" ToolTip.Tip="{l:T 'AI assistants: Claude, Codex, Gemini and other MCP apps'}">
            <Panel>
              <Border Classes="navpill" />
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="4,0">
                <Panel Width="26" Height="19" HorizontalAlignment="Center">
                  <Path Classes="navicon" Data="M12 3 L13.6 9.2 L20 10.8 L13.6 12.4 L12 18.8 L10.4 12.4 L4 10.8 L10.4 9.2 Z M18.5 16 L19.2 18.3 L21.5 19 L19.2 19.7 L18.5 22 L17.8 19.7 L15.5 19 L17.8 18.3 Z" />
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource GreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,0,0"
                           IsVisible="{Binding IsAiActive}" />
                </Panel>
                <TextBlock Classes="navlabel" Text="{l:T 'AI'}" />
              </StackPanel>
            </Panel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

  <DockPanel Grid.Column="1" Margin="22,14,22,12">

    <!-- header: Devices shows Paneless + summary; sub-pages show a slim utility strip so page titles sit cleanly on top -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel VerticalAlignment="Center" Spacing="2" IsVisible="{Binding IsDevicesPage}">
        <TextBlock Text="Paneless" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Classes="dim" FontSize="12.5" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Classes="small" VerticalAlignment="Center" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsDevicesPage}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBox x:Name="SearchBox" Width="236" Text="{Binding Search}" PlaceholderText="{l:T 'Search devices  (Ctrl+F)'}" IsVisible="{Binding IsDevicesPage}">
          <TextBox.InnerLeftContent>
            <Path Classes="icon" Width="15" Height="15" Margin="10,0,0,0" Stroke="{DynamicResource DimBrush}"
                  Data="M10.5 4 A6.5 6.5 0 1 1 10.49 4 Z M15.2 15.2 L20 20" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="searchclear" Content="✕" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearch}" ToolTip.Tip="{l:T 'Clear'}" />
          </TextBox.InnerRightContent>
        </TextBox>
        <DropDownButton Content="{l:T '+ Add device'}" ToolTip.Tip="{l:T 'Pair a new device, or connect one by its address'}">
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="330" Spacing="10" Margin="4">
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Devices plugged in via USB or with Wireless debugging on show up automatically. For Wi-Fi, pair once with a code.'}" />
                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Content="{l:T 'Pair with a code…'}" Command="{Binding PairCommand}" />
                <TextBlock Classes="label" Text="{l:T 'Not listed? Connect by address'}" Margin="0,6,0,0" />
                <Grid ColumnDefinitions="*,8,Auto">
                  <TextBox Text="{Binding ManualAddress}" PlaceholderText="{l:T 'IP:port, e.g. 192.168.2.40:37123'}">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Grid.Column="2" Content="{l:T 'Connect'}" Command="{Binding ConnectCommand}" />
                </Grid>
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Content="{l:T 'Scripts'}" Command="{Binding OpenScriptsCommand}" ToolTip.Tip="{l:T 'Your saved adb commands and the built-in ones'}" />
        <Button Padding="10,7" ToolTip.Tip="{l:T 'Support Paneless'}">
          <TextBlock Text="♥" Foreground="#ea4aaa" FontSize="15" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="290" Spacing="10" Margin="4">
                <TextBlock Text="{l:T 'Support Paneless'}" FontWeight="SemiBold" FontSize="15" />
                <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                           Text="{l:T 'Paneless is free and open source. If it saves you time, you can support its development. Thank you!'}" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Static app:AppLinks.KoFi}" Click="OpenLink">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="☕" />
                    <TextBlock Text="{l:T 'Buy me a coffee on Ko-fi'}" />
                  </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Tag="{x:Static app:AppLinks.Repository}" Click="OpenLink">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⭐" />
                    <TextBlock Text="{l:T 'Star it or report a bug on GitHub'}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- status line -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="dim" FontSize="12" Text="{Binding Tip}" Margin="16,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsDevicesPage}"
                 ToolTip.Tip="{l:T 'Drop files or APKs on a device or group to copy or install them.'}" />
    </Grid>

    <Panel>
    <DockPanel IsVisible="{Binding IsDevicesPage}">
    <!-- action bar: what to do with the selected devices; options for mirroring on the right -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" MinWidth="104" Content="{Binding MirrorLabel}" Command="{Binding MirrorCommand}" FontWeight="SemiBold"
                ToolTip.Tip="{l:T 'Mirror the selected devices (Enter or double-click)'}" />
        <Button Content="{l:T 'Run script…'}" Command="{Binding RunScriptCommand}" ToolTip.Tip="{l:T 'Run a script on the selected devices'}" />
        <Button Content="{l:T 'Groups…'}" Command="{Binding ManageGroupsCommand}"
                ToolTip.Tip="{l:T 'Create, rename and order groups, and choose which devices are in each'}" />
        <DropDownButton Content="{l:T 'Unlock'}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="{l:T 'Unlock now'}" Command="{Binding UnlockNowCommand}" />
              <MenuItem Header="{l:T 'Auto-unlock settings…'}" Command="{Binding AutoUnlockCommand}" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <DropDownButton Content="{l:T 'More'}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="{l:T 'Device settings…'}" Command="{Binding DeviceSettingsCommand}" />
              <MenuItem Header="{l:T 'Apps…'}" Command="{Binding AppsCommand}" />
              <MenuItem Header="{l:T 'Files &amp; photos…'}" Command="{Binding FilesCommand}" />
              <MenuItem Header="{l:T 'Quick controls &amp; media…'}" Command="{Binding QuickControlsCommand}" />
              <MenuItem Header="{l:T 'Send files or apps…'}" Command="{Binding SendFilesCommand}" />
              <Separator />
              <MenuItem Header="{l:T 'Open a second screen'}" Command="{Binding SecondScreenCommand}" />
              <MenuItem Header="{l:T 'Pop out current app'}" Command="{Binding PopOutCurrentAppCommand}" />
              <MenuItem Header="{l:T 'Back camera'}" Command="{Binding CameraBackCommand}" />
              <MenuItem Header="{l:T 'Front camera'}" Command="{Binding CameraFrontCommand}" />
              <MenuItem Header="{l:T 'Locate device'}" Command="{Binding LocateCommand}" />
              <MenuItem Header="{l:T 'Switch to Wi-Fi'}" Command="{Binding SwitchToWifiCommand}" IsVisible="{Binding CanSwitchToWifi}" />
              <Separator />
              <MenuItem Header="{l:T 'Arrange all mirror windows'}" Command="{Binding ArrangeAllCommand}" />
              <MenuItem Header="{l:T 'Export for remote tools…'}" Command="{Binding ExportConnectionsCommand}" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Border Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="12" Padding="10,3" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding ShowSelectionBadge}">
          <TextBlock Text="{Binding SelectionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource LinkBrush}" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <DropDownButton Content="{l:T 'Mirror options'}" ToolTip.Tip="{l:T 'How new mirrors start'}">
          <DropDownButton.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Width="300" Spacing="8" Margin="4">
                <TextBlock Classes="label" Text="{l:T 'For mirrors you start from now on'}" />
                <CheckBox Content="{l:T 'Keep device screen off'}" IsChecked="{Binding ScreenOff}"
                          ToolTip.Tip="{l:T 'Mirror while the device’s own screen stays dark. With auto-unlock it lights up only for a moment to unlock. If it turns on again, press Alt+O in the mirror window.'}" />
                <CheckBox Content="{l:T 'Keep awake'}" IsChecked="{Binding KeepAwake}" IsEnabled="{Binding KeepAwakeEnabled}"
                          ToolTip.Tip="{l:T 'Stops the device’s screen from timing out (and locking) while it’s mirrored. Always on while the screen is kept off.'}" />
                <CheckBox Content="{l:T 'Lock device when mirror closes'}" IsChecked="{Binding LockOnClose}"
                          ToolTip.Tip="{l:T 'Puts the device to sleep (and locks it) when its last mirror or second-screen window closes.'}" />
                <CheckBox Content="{l:T 'Play device audio on this computer'}" IsChecked="{Binding Audio}" />
                <CheckBox Content="{l:T 'Mirror windows always on top'}" IsChecked="{Binding OnTop}" />
                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                  <TextBlock Text="{l:T 'Max size'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding MaxSizes}" SelectedItem="{Binding MaxSize}" />
                </Grid>
                <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{l:T 'Quality (codec, bit rate, frame rate) and per-device settings are in Settings.'}" />
                <Button Content="{l:T 'Settings…'}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Flyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Padding="9,7" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T 'Refresh the list (F5)'}">
          <Path Classes="icon" Data="M18.5 8.5 A7 7 0 1 0 19 13.5 M18.5 3.5 V8.5 H13.5" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- device list -->
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource HeaderBrush}"
              ColumnDefinitions="2.2*,1.5*,0.9*,0.8*,1.3*,1.7*,1*">
          <TextBlock Grid.Column="0" Classes="colhead" Text="{l:T 'Device'}" />
          <TextBlock Grid.Column="1" Classes="colhead" Text="{l:T 'Status'}" />
          <TextBlock Grid.Column="2" Classes="colhead" Text="{l:T 'Battery'}" />
          <TextBlock Grid.Column="3" Classes="colhead" Text="{l:T 'Type'}" />
          <TextBlock Grid.Column="4" Classes="colhead" Text="{l:T 'Model'}" />
          <TextBlock Grid.Column="5" Classes="colhead" Text="{l:T 'Address'}" />
          <TextBlock Grid.Column="6" Classes="colhead" Text="{l:T 'Auto-unlock'}" />
        </Grid>
        <Panel>
          <ListBox x:Name="DeviceList" ItemsSource="{Binding Items}" SelectionMode="Multiple" Background="Transparent"
                   DragDrop.AllowDrop="True">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{l:T 'Mirror'}" Command="{Binding MirrorCommand}" FontWeight="SemiBold" />
                <MenuItem Header="{l:T 'Run a script…'}" Command="{Binding RunScriptCommand}" />
                <MenuItem Header="{l:T 'Apps…'}" Command="{Binding AppsCommand}" />
                <MenuItem Header="{l:T 'Files &amp; photos…'}" Command="{Binding FilesCommand}" />
                <MenuItem Header="{l:T 'Quick controls &amp; media…'}" Command="{Binding QuickControlsCommand}" />
                <MenuItem Header="{l:T 'Send files or apps…'}" Command="{Binding SendFilesCommand}" />
                <MenuItem Header="{l:T 'Open a second screen'}" Command="{Binding SecondScreenCommand}" />
                <MenuItem Header="{l:T 'Pop out current app'}" Command="{Binding PopOutCurrentAppCommand}" />
                <MenuItem Header="{l:T 'Camera'}">
                  <MenuItem Header="{l:T 'Back camera'}" Command="{Binding CameraBackCommand}" />
                  <MenuItem Header="{l:T 'Front camera'}" Command="{Binding CameraFrontCommand}" />
                </MenuItem>
                <MenuItem Header="{l:T 'Locate device'}" Command="{Binding LocateCommand}" />
                <MenuItem Header="{l:T 'Switch to Wi-Fi'}" Command="{Binding SwitchToWifiCommand}" IsVisible="{Binding CanSwitchToWifi}" />
                <Separator />
                <MenuItem Name="MoveMenu" Header="{l:T 'Move to group'}" />
                <MenuItem Header="{l:T 'Device settings…'}" Command="{Binding DeviceSettingsCommand}" />
                <MenuItem Header="{l:T 'Export for remote tools…'}" Command="{Binding ExportConnectionsCommand}" />
                <Separator />
                <MenuItem Header="{l:T 'Unlock now'}" Command="{Binding UnlockNowCommand}" />
                <MenuItem Header="{l:T 'Auto-unlock settings…'}" Command="{Binding AutoUnlockCommand}" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.DataTemplates>

              <DataTemplate DataType="vm:GroupHeaderViewModel">
                <Grid Height="36" ColumnDefinitions="*,Auto,Auto" Background="{DynamicResource HeaderBrush}">
                  <Button Classes="grouphead" Command="{Binding ToggleCommand}" ToolTip.Tip="{l:T 'Click to collapse or expand. Right-click for more.'}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{l:T 'Select all in this group'}" Command="{Binding SelectAllCommand}" />
                        <MenuItem Header="{l:T 'Mirror all'}" Command="{Binding MirrorAllCommand}" />
                        <MenuItem Header="{l:T 'Run a script on this group…'}" Command="{Binding RunScriptCommand}" />
                        <MenuItem Header="{l:T 'Send files or apps to this group…'}" Command="{Binding SendFilesCommand}" />
                        <MenuItem Header="{l:T 'Arrange this group’s mirror windows'}" Command="{Binding ArrangeCommand}" />
                        <MenuItem Header="{l:T 'Export for remote tools…'}" Command="{Binding ExportConnectionsCommand}" />
                        <MenuItem Header="{l:T 'Group settings…'}" Command="{Binding SettingsCommand}" IsVisible="{Binding IsUserGroup}" />
                        <Separator IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Rename…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Move up'}" Command="{Binding MoveUpCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Move down'}" Command="{Binding MoveDownCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Delete group'}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsUserGroup}" />
                        <Separator />
                        <MenuItem Header="{l:T 'Manage groups…'}" Command="{Binding ManageCommand}" />
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Panel Width="16">
                        <Path Classes="chevron" Data="M4 6 L8 10 L12 6" IsVisible="{Binding !IsCollapsed}" />
                        <Path Classes="chevron" Data="M6 4 L10 8 L6 12" IsVisible="{Binding IsCollapsed}" />
                      </Panel>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CountText}" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="4,1,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Grid.Column="1" Classes="link" Content="{l:T 'Mirror all'}" Command="{Binding MirrorAllCommand}"
                          IsVisible="{Binding CanMirrorAll}" ToolTip.Tip="{l:T 'Mirror every available device in this group'}" />
                  <Button Grid.Column="2" Classes="link" Margin="0,0,6,0" Padding="10,2" Content="⋯" FontSize="16" ToolTip.Tip="{l:T 'Group actions'}">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{l:T 'Select all in this group'}" Command="{Binding SelectAllCommand}" />
                        <MenuItem Header="{l:T 'Mirror all'}" Command="{Binding MirrorAllCommand}" />
                        <MenuItem Header="{l:T 'Run a script on this group…'}" Command="{Binding RunScriptCommand}" />
                        <MenuItem Header="{l:T 'Send files or apps to this group…'}" Command="{Binding SendFilesCommand}" />
                        <MenuItem Header="{l:T 'Arrange this group’s mirror windows'}" Command="{Binding ArrangeCommand}" />
                        <MenuItem Header="{l:T 'Export for remote tools…'}" Command="{Binding ExportConnectionsCommand}" />
                        <MenuItem Header="{l:T 'Group settings…'}" Command="{Binding SettingsCommand}" IsVisible="{Binding IsUserGroup}" />
                        <Separator IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Rename…'}" Command="{Binding RenameCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Move up'}" Command="{Binding MoveUpCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Move down'}" Command="{Binding MoveDownCommand}" IsVisible="{Binding IsUserGroup}" />
                        <MenuItem Header="{l:T 'Delete group'}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsUserGroup}" />
                        <Separator />
                        <MenuItem Header="{l:T 'Manage groups…'}" Command="{Binding ManageCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </DataTemplate>

              <DataTemplate DataType="vm:DeviceItemViewModel">
                <Grid Height="36" ColumnDefinitions="2.2*,1.5*,0.9*,0.8*,1.3*,1.7*,1*" Background="Transparent">
                  <TextBlock Grid.Column="0" Classes="cell" Margin="{Binding NameMargin}" Text="{Binding Name}"
                             Foreground="{Binding NameBrush}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="cell" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                  <TextBlock Grid.Column="2" Classes="cell mono" Text="{Binding BatteryText}" Foreground="{Binding BatteryBrush}" />
                  <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Type}" />
                  <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Model}" />
                  <TextBlock Grid.Column="5" Classes="cell mono" Text="{Binding Address}" />
                  <TextBlock Grid.Column="6" Classes="cell" Text="{Binding UnlockText}" Foreground="{Binding UnlockBrush}" />
                </Grid>
              </DataTemplate>

            </ListBox.DataTemplates>
          </ListBox>
          <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyText}" Classes="dim"
                     TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="24" />
        </Panel>
      </DockPanel>
    </Border>
    </DockPanel>
    <Panel IsVisible="{Binding IsWallPage}"><views:WallPage x:Name="WallPage" /></Panel>
    <Panel IsVisible="{Binding IsLogsPage}"><views:LogsPage x:Name="LogsPage" /></Panel>
    <Panel IsVisible="{Binding IsAutomationPage}"><views:AutomationPage x:Name="AutomationPage" /></Panel>
    <Panel IsVisible="{Binding IsInventoryPage}"><views:InventoryPage x:Name="InventoryPage" /></Panel>
    <Panel IsVisible="{Binding IsAssistantsPage}"><views:AssistantsPage x:Name="AssistantsPage" /></Panel>
    <Panel IsVisible="{Binding IsRemoteAppsPage}"><views:RemoteAppsPage x:Name="RemoteAppsPage" /></Panel>
    </Panel>
  </DockPanel>
  </Grid>
</Window>
