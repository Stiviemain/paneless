<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:views="using:Paneless.App.Views"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.EmbeddedSessionWindow"
        Title="Paneless"
        Width="528" Height="850"
        MinWidth="240" MinHeight="240"
        Background="#111111"
        WindowStartupLocation="CenterScreen">

  <Grid x:Name="RootGrid" ColumnDefinitions="*,Auto" Background="#111111">
    <Panel x:Name="HostArea" Grid.Column="0" Background="#111111">
      <StackPanel x:Name="Overlay"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10"
                  Margin="24"
                  MaxWidth="420">
        <TextBlock x:Name="TitleText"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#F2F2F2"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText"
                   FontSize="13"
                   Foreground="#B5B5B5"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button x:Name="RetryButton"
                Content="{l:T 'Reconnect'}"
                HorizontalAlignment="Center"
                Margin="0,6,0,0"
                IsVisible="False"
                Click="OnRetryClick" />
      </StackPanel>
    </Panel>

    <Border x:Name="ToolbarPanel"
            Grid.Column="1"
            Width="48"
            IsVisible="False"
            Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1,0,0,0"
            x:DataType="vm:ToolbarViewModel">
      <views:MirrorToolbarStrip x:Name="ToolbarStrip" />
    </Border>
  </Grid>
</Window>
