<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.AppsWindow"
        x:DataType="vm:AppsViewModel"
        Title="{Binding Title}" Icon="/Assets/Paneless.ico"
        Width="820" Height="620" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="ListBox#AppList ListBoxItem">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox#AppList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SelBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="20,18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Content="{l:T 'Show system apps'}" IsChecked="{Binding ShowSystem}" Margin="0,0,12,0" />
      <Button Grid.Column="2" Content="{l:T 'Refresh'}" Command="{Binding ReloadCommand}" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" x:Name="CloseButton" Content="{l:T 'Close'}" MinWidth="90" IsCancel="True" Margin="12,0,0,0" />
    </Grid>

    <Grid ColumnDefinitions="*,16,230">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="{l:T 'Filter by package name, e.g. whatsapp'}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
          <Panel>
            <ListBox x:Name="AppList" ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AppItem">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Package}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{DynamicResource AmberBrush}" FontSize="12" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" />
          </Panel>
        </Border>
      </DockPanel>

      <StackPanel Grid.Column="2" Spacing="8">
        <TextBlock Text="{l:T 'Selected app'}" Classes="dim" FontSize="12" />
        <Button Classes="accent" HorizontalAlignment="Stretch" Content="{l:T 'Open'}" Command="{Binding OpenCommand}" ToolTip.Tip="{l:T 'Opens it on the device'}" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Add to Remote apps'}" Command="{Binding AddToRemoteAppsCommand}"
                ToolTip.Tip="{l:T 'Keep this app on the Remote apps page: one click opens it in its own window, and it can have a shortcut.'}" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Open in its own window'}" Command="{Binding OpenInWindowCommand}"
                ToolTip.Tip="{l:T 'Runs the app on a separate, resizable screen of the device and shows it in a window here. The device’s own screen stays as it is.'}" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Force stop'}" Command="{Binding ForceStopCommand}" />
        <Button HorizontalAlignment="Stretch" Content="{Binding ToggleLabel}" Command="{Binding ToggleEnabledCommand}" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Clear data…'}" Command="{Binding ClearDataCommand}" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Uninstall…'}" Command="{Binding UninstallCommand}" />
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8" />
        <Button HorizontalAlignment="Stretch" Content="{l:T 'Install an APK…'}" Command="{Binding InstallCommand}" />
        <CheckBox IsChecked="{Binding AlsoOnGroup}" IsVisible="{Binding InGroup}">
          <TextBlock Text="{Binding AlsoOnGroupText}" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock Classes="dim" FontSize="12" TextWrapping="Wrap"
                   Text="{l:T 'Tip: you can also drop APKs on a device or group in the main window.'}" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
