<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.QuickControlsWindow"
        x:DataType="vm:QuickControlsViewModel"
        Title="{Binding Title}" Icon="/Assets/Paneless.ico"
        Width="520" Height="660" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="20,18">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="{l:T 'Refresh'}" Command="{Binding LoadCommand}" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" x:Name="CloseButton" Content="{l:T 'Done'}" Classes="accent" MinWidth="84" IsCancel="True" Margin="12,0,0,0" />
    </Grid>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,10,0">
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
          <StackPanel Spacing="8">
            <TextBlock Text="{l:T 'Now playing'}" Classes="dim" FontSize="12" />
            <TextBlock Text="{Binding MediaTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding MediaArtist}" Classes="dim" FontSize="12" IsVisible="{Binding !!MediaArtist.Length}" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="{l:T 'Previous'}" Command="{Binding MediaPreviousCommand}" />
              <Button Classes="accent" MinWidth="84" Content="{Binding PlayPauseLabel}" Command="{Binding MediaPlayPauseCommand}" />
              <Button Content="{l:T 'Next'}" Command="{Binding MediaNextCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Text="{l:T 'Quick toggles'}" Classes="dim" FontSize="12" />
            <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Dark mode'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding DarkMode}" />
              </Grid>
              <Grid Grid.Column="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Do not disturb'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding Dnd}" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Auto-rotate'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding AutoRotate}" />
              </Grid>
              <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Auto-brightness'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding AutoBrightness}" />
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Wi-Fi'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding Wifi}" />
              </Grid>
              <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T 'Bluetooth'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0" IsChecked="{Binding Bluetooth}" />
              </Grid>
            </Grid>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
          <StackPanel Spacing="10">
            <TextBlock Text="{l:T 'Brightness &amp; volume'}" Classes="dim" FontSize="12" />
            <Grid ColumnDefinitions="96,*,56" ColumnSpacing="10">
              <TextBlock Text="{l:T 'Brightness'}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Brightness}" />
              <TextBlock Grid.Column="2" Text="{Binding BrightnessText}" Classes="dim mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="96,*,56" ColumnSpacing="10">
              <TextBlock Text="{l:T 'Media'}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="{Binding MusicMax}" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding MusicVolume}" />
              <TextBlock Grid.Column="2" Text="{Binding MusicVolumeText}" Classes="dim mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="96,*,56" ColumnSpacing="10">
              <TextBlock Text="{l:T 'Ring'}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="0" Maximum="{Binding RingMax}" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RingVolume}" />
              <TextBlock Grid.Column="2" Text="{Binding RingVolumeText}" Classes="dim mono" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
