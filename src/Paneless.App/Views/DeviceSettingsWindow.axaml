<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Paneless.App.Localization"
        xmlns:vm="using:Paneless.App.ViewModels"
        x:Class="Paneless.App.Views.DeviceSettingsWindow"
        x:DataType="vm:ProfileEditorViewModel"
        Title="{Binding Title}" Icon="/Assets/Paneless.ico"
        Width="880" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="22,18">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Subtitle}" Classes="dim" TextWrapping="Wrap" />
    </StackPanel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,14,0,0">
      <TextBlock Text="{Binding Message}" Foreground="{Binding MessageBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="{l:T 'Reset to Default'}" Command="{Binding ResetAllCommand}" Margin="0,0,8,0" />
      <Button Grid.Column="2" x:Name="CloseButton" Classes="accent" Content="{l:T 'Done'}" MinWidth="90" IsCancel="True" IsDefault="True" />
    </Grid>

    <Grid ColumnDefinitions="*,24,*">
      <!-- left: mirroring -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{l:T 'Mirroring'}" />
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingRow">
                <Grid ColumnDefinitions="170,*" Margin="0,0,0,8" ToolTip.Tip="{Binding Tip}">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="section" Text="{l:T 'Files'}" Margin="0,10,0,4" />
          <TextBlock Classes="label" Text="{l:T 'Folder on the device for files you drop on it'}" />
          <TextBox Text="{Binding PushTarget}" PlaceholderText="{Binding PushPlaceholder}" />

          <StackPanel IsVisible="{Binding IsDevice}" Spacing="6" Margin="0,10,0,0">
            <TextBlock Classes="section" Text="{l:T 'Shortcut'}" Margin="0,0,0,0" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="{l:T 'Click the box and press a key combination, e.g. Ctrl+Alt+P. It mirrors this device from anywhere (or brings its mirror to the front).'}" />
            <Grid ColumnDefinitions="*,8,Auto">
              <TextBox x:Name="HotkeyBox" Text="{Binding Hotkey}" IsReadOnly="True" PlaceholderText="{l:T 'No shortcut'}" />
              <Button Grid.Column="2" Content="{l:T 'Clear'}" Command="{Binding ClearHotkeyCommand}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- right: when it connects -->
      <DockPanel Grid.Column="2">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
          <TextBlock Classes="section" Text="{l:T 'When it connects'}" />
          <Grid ColumnDefinitions="170,*" ToolTip.Tip="{Binding AutoMirror.Tip}">
            <TextBlock Text="{Binding AutoMirror.Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AutoMirror.Choices}" SelectedItem="{Binding AutoMirror.Selected}" />
          </Grid>
          <TextBlock Classes="label" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{l:T 'Run these scripts every time it connects (also after a restart of the device or of Paneless). Only scripts that need no values are listed.'}" />
          <TextBox Text="{Binding ScriptFilter}" PlaceholderText="{l:T 'Filter scripts'}" />
        </StackPanel>
        <Border Margin="0,8,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ShownScripts}" Margin="10,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScriptPick">
                  <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="30">
                    <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Editable}" MinWidth="0" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Category}" Classes="dim" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
